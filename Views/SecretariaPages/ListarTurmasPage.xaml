<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudyFlow.Views.SecretariaPages.ListarTurmasPage"
             BackgroundColor="#E8F5E9">

    <VerticalStackLayout Padding="20" Spacing="10">

        <Label Text="Turmas"
               FontSize="22"
               FontAttributes="Bold"
               TextColor="#2E7D32"/>

        <CollectionView x:Name="listaTurmas">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="5" Padding="10">
                        <VerticalStackLayout>
                            <Label Text="{Binding Nome}" FontAttributes="Bold"/>
                            <Label Text="{Binding Periodo}"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>

</ContentPage>