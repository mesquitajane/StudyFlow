<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudyFlow.Views.SecretariaPages.MuralAvisosPage"
             BackgroundColor="#E8F5E9">

    <Grid RowDefinitions="Auto, *" Padding="25">

        <VerticalStackLayout Grid.Row="0" Spacing="5" Margin="0,0,0,20">
            <Label Text="Mural de Avisos" FontSize="26" FontAttributes="Bold" 
                   TextColor="#2E7D32" HorizontalOptions="Center"/>
            <Label Text="Fique por dentro das novidades da escola." 
                   FontSize="14" TextColor="#424242" HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <!-- Se não houver avisos, esta lista ficará vazia -->
        <CollectionView Grid.Row="1" x:Name="listaAvisos">
            <CollectionView.EmptyView>
                <Label Text="Nenhum aviso no momento." 
                       HorizontalOptions="Center" VerticalOptions="Center" TextColor="Gray" FontSize="16"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <!-- Visual de "Carta/Aviso" -->
                    <Frame Padding="20" Margin="0,8" BackgroundColor="#FFFFFF" 
                           CornerRadius="12" HasShadow="True" BorderColor="#A5D6A7">
                        <VerticalStackLayout Spacing="8">

                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="{Binding Titulo}" FontAttributes="Bold" FontSize="18" TextColor="#1B5E20"/>
                                <Label Grid.Column="1" Text="{Binding DataPublicacao, StringFormat='{0:dd/MM}'}" 
                                       FontSize="12" TextColor="#757575" FontAttributes="Bold" VerticalOptions="Center"/>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#E8F5E9" Margin="0,5"/>

                            <Label Text="{Binding Mensagem}" FontSize="15" TextColor="#212121"/>

                            <Label Text="{Binding PublicoAlvo, StringFormat='Direcionado para: {0}'}" 
                                   FontSize="11" TextColor="#388E3C" FontAttributes="Italic" 
                                   HorizontalOptions="End" Margin="0,10,0,0"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>