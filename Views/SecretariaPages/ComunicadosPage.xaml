<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudyFlow.Views.SecretariaPages.ComunicadosPage"
             BackgroundColor="#E8F5E9">

    <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="25">

        <VerticalStackLayout Grid.Row="0" Spacing="10" Margin="0,0,0,15">
            <Label Text="Gerenciar Comunicados" FontSize="26" FontAttributes="Bold" 
                   TextColor="#2E7D32" HorizontalOptions="Center"/>
            <Button Text="+ Novo Comunicado" Clicked="OnNovoComunicadoClicked" 
                    BackgroundColor="#4CAF50" TextColor="White" CornerRadius="10"/>
        </VerticalStackLayout>

        <SearchBar Grid.Row="1" x:Name="searchComunicados" 
                   Placeholder="Pesquisar título..." 
                   TextColor="Black" PlaceholderColor="Gray" BackgroundColor="White"
                   TextChanged="OnPesquisarTextChanged" Margin="0,0,0,10"/>

        <CollectionView Grid.Row="2" x:Name="listaComunicados">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="15" Margin="0,5" BackgroundColor="White" CornerRadius="10" HasShadow="True" BorderColor="#C8E6C9">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding Titulo}" FontAttributes="Bold" FontSize="18" TextColor="#1B5E20"/>
                            <Label Text="{Binding Mensagem}" FontSize="14" TextColor="#424242" MaxLines="2" LineBreakMode="TailTruncation"/>

                            <HorizontalStackLayout Spacing="15" Margin="0,5,0,0">
                                <Label Text="{Binding PublicoAlvo, StringFormat='Para: {0}'}" FontSize="12" FontAttributes="Bold" TextColor="#2E7D32"/>
                                <Label Text="{Binding DataPublicacao, StringFormat='Data: {0:dd/MM/yyyy}'}" FontSize="12" TextColor="#757575"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="10" Margin="0,15,0,0">
                                <Button Text="Editar" BackgroundColor="#1565C0" TextColor="White" CornerRadius="5" HeightRequest="40"
                                        Clicked="OnEditarClicked" CommandParameter="{Binding .}"/>
                                <Button Text="Excluir" BackgroundColor="#C62828" TextColor="White" CornerRadius="5" HeightRequest="40"
                                        Clicked="OnExcluirClicked" CommandParameter="{Binding IdComunicado}"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="3" Text="Voltar ao Painel" Clicked="OnVoltarClicked" 
                BackgroundColor="#757575" TextColor="White" CornerRadius="10" Margin="0,10,0,0"/>
    </Grid>
</ContentPage>