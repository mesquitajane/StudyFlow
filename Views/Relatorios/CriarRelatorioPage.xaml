<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudyFlow.Views.Relatorios.CriarRelatorioPage"
             BackgroundColor="#E8F5E9">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="20">
            <Label Text="Gerar Relatório Comportamental" 
                   FontSize="24" FontAttributes="Bold" 
                   TextColor="#2E7D32" HorizontalOptions="Center" />

            <VerticalStackLayout Spacing="5">
                <Label Text="Selecione a Turma:" TextColor="#2E7D32" FontAttributes="Bold"/>
                <Frame Padding="2" CornerRadius="10" HasShadow="False">
                    <Picker x:Name="pickerTurma" Title="Escolha a Turma" 
                            SelectedIndexChanged="OnTurmaSelected"
                            TextColor="Black" TitleColor="Gray" BackgroundColor="White"/>
                </Frame>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Selecione o Aluno (N°):" TextColor="#2E7D32" FontAttributes="Bold"/>
                <Frame Padding="2" CornerRadius="10" HasShadow="False">
                    <Picker x:Name="pickerAluno" Title="Escolha o Aluno" 
                            IsEnabled="False"
                            TextColor="Black" TitleColor="Gray" BackgroundColor="White"/>
                </Frame>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Relato do Comportamento:" TextColor="#2E7D32" FontAttributes="Bold"/>
                <Frame Padding="5" CornerRadius="10" HasShadow="False">
                    <Editor x:Name="editorRelato" Placeholder="Descreva o comportamento do aluno..."
                            HeightRequest="150" BackgroundColor="White" TextColor="Black"/>
                </Frame>
            </VerticalStackLayout>

            <Button Text="Salvar Relatório" Clicked="OnSalvarClicked" 
                    BackgroundColor="#4CAF50" TextColor="White" CornerRadius="10" HeightRequest="50"/>

            <Button Text="Voltar" Clicked="OnVoltarClicked" 
                    BackgroundColor="#757575" TextColor="White" CornerRadius="10" HeightRequest="50"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>