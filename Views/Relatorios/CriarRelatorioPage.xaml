<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudyFlow.Views.Relatorios.CriarRelatorioPage">
    
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Gerar Relatório Comportamental" FontSize="20" FontAttributes="Bold" TextColor="#1B5E20" />

        <Label Text="Selecione a Turma:" TextColor="Black"/>
        <Picker x:Name="pickerTurma" Title="Escolha a Turma" 
            SelectedIndexChanged="OnTurmaSelected"
            TextColor="Black" TitleColor="Gray" BackgroundColor="White"/>

        <Label Text="Selecione o Aluno:" TextColor="Black"/>
        <Picker x:Name="pickerAluno" Title="Escolha o Aluno" 
            IsEnabled="False"
            TextColor="Black" TitleColor="Gray" BackgroundColor="White"/>

        <Label Text="Relato do Comportamento:" TextColor="Black"/>
        <Editor x:Name="editorRelato" Placeholder="Descreva o comportamento do aluno..."
            HeightRequest="150" BackgroundColor="White" TextColor="Black"/>

        <Button Text="Salvar Relatório" 
            Clicked="OnSalvarClicked" 
            BackgroundColor="#1B5E20" TextColor="White" CornerRadius="10"/>
    </VerticalStackLayout>
</ContentPage>