<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudyFlow.Views.Relatorios.ListaRelatoriosPage"
             BackgroundColor="#F5F5F5">

    <CollectionView x:Name="listaRelatorios" Margin="10">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Margin="0,5" Padding="15" BackgroundColor="White" CornerRadius="10">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="📅" VerticalOptions="Center"/>
                            <Label Text="{Binding DataFormatada}" FontSize="12" TextColor="Gray"/>
                        </HorizontalStackLayout>

                        <Label Text="{Binding Relatorio.Comportamento}" 
                               FontSize="16" TextColor="#212121" FontAttributes="Italic"/>

                        <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,5"/>

                        <Label Text="{Binding NomeProfessor, StringFormat='Escrito por: Prof. {0}'}" 
                               FontSize="12" FontAttributes="Bold" TextColor="#1B5E20"/>
                    </VerticalStackLayout>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>