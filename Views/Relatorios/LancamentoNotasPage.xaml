<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudyFlow.Views.Relatorios.LancamentoNotasPage"
             BackgroundColor="#E8F5E9">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="20">
            <Label Text="Lançar Notas" FontSize="26" FontAttributes="Bold" 
                   TextColor="#2E7D32" HorizontalOptions="Center" />

            <VerticalStackLayout Spacing="5">
                <Label Text="Turma:" TextColor="#2E7D32" FontAttributes="Bold"/>
                <Picker x:Name="pickerTurma" Title="Selecione a Turma" 
                        SelectedIndexChanged="OnTurmaSelected"
                        TextColor="Black" BackgroundColor="White"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Aluno:" TextColor="#2E7D32" FontAttributes="Bold"/>
                <Picker x:Name="pickerAluno" Title="Selecione o Aluno" 
                        IsEnabled="False" TextColor="Black" BackgroundColor="White"/>
            </VerticalStackLayout>

            <Entry x:Name="entryTipo" Placeholder="Tipo (Ex: Prova 1, Trabalho)" 
                   TextColor="Black" PlaceholderColor="Gray" BackgroundColor="White"/>

            <Entry x:Name="entryNota" Placeholder="Nota (0 a 10)" Keyboard="Numeric"
                   TextColor="Black" PlaceholderColor="Gray" BackgroundColor="White"/>

            <Button Text="Salvar Nota" Clicked="OnSalvarClicked" 
                    BackgroundColor="#4CAF50" TextColor="White" CornerRadius="10" />

            <Button Text="Voltar" Clicked="OnVoltarClicked" 
                    BackgroundColor="#757575" TextColor="White" CornerRadius="10" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>