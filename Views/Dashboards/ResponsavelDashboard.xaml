<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudyFlow.Views.Dashboards.ResponsavelDashboard"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto, *" Padding="20">
        <VerticalStackLayout Grid.Row="0" Spacing="5" Margin="0,0,0,10">
            <Label x:Name="lblBoasVindas" Text="Olá!" FontSize="24" FontAttributes="Bold" TextColor="#1B5E20"/>
            <Label Text="Acompanhe o progresso do seu dependente" FontSize="14" TextColor="#666"/>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="15">

                <Frame Padding="15" CornerRadius="10" BackgroundColor="White" HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Adicionar Filho por CPF" FontAttributes="Bold" TextColor="#1B5E20"/>
                        <HorizontalStackLayout Spacing="10">
                            <Entry x:Name="entryCpfFilho" Placeholder="000.000.000-00" 
                                   Keyboard="Numeric" WidthRequest="180" TextColor="Black"/>
                            <Button Text="Vincular" Clicked="OnVincularFilhoClicked" 
                                    BackgroundColor="#1B5E20" CornerRadius="5" HeightRequest="45"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <Label Text="Meus Dependentes:" FontSize="18" FontAttributes="Bold" TextColor="#1B5E20" Margin="0,10,0,0"/>

                <CollectionView x:Name="listaFilhos" HeightRequest="200">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Margin="0,5" Padding="10" BackgroundColor="White" HasShadow="False" BorderColor="#E0E0E0">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnFilhoSelected" />
                                </Frame.GestureRecognizers>
                                <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                                    <Label Text="👤" FontSize="24" VerticalOptions="Center"/>
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Text="{Binding IdAluno, StringFormat='Aluno ID: {0}'}" FontAttributes="Bold" TextColor="Black"/>
                                        <Label Text="{Binding Turma, StringFormat='Turma: {0}'}" FontSize="12" TextColor="Gray"/>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <BoxView HeightRequest="1" Color="#E0E0E0" />

                <Button Text="Ver Comportamento" Clicked="OnVerComportamentoClicked" BackgroundColor="#2E7D32" TextColor="White"/>
                <Button Text="Comunicados da Escola" BackgroundColor="#2E7D32" TextColor="White"  Clicked="OnVerAvisosClicked"/>
                <Button Text="Falar com a Secretaria" BackgroundColor="#2E7D32" TextColor="White"/>
                <Button Text="Sair" Clicked="OnSairClicked" BackgroundColor="#C62828" TextColor="White" Margin="0,10,0,0"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>