<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudyFlow.Views.Tarefas.EntregarTarefaPage"
             BackgroundColor="#E8F5E9">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="15">

            <Label Text="Responder Tarefa" FontSize="24" FontAttributes="Bold" 
                   TextColor="#2E7D32" HorizontalOptions="Center" />

            <Frame BackgroundColor="White" CornerRadius="10" Padding="15" HasShadow="True">
                <VerticalStackLayout Spacing="5">
                    <Label x:Name="lblTitulo" FontSize="20" FontAttributes="Bold" TextColor="#2E7D32"/>
                    <Label x:Name="lblDescricao" FontSize="15" TextColor="#424242"/>
                    <Label x:Name="lblData" FontSize="12" TextColor="#C62828" FontAttributes="Italic"/>
                </VerticalStackLayout>
            </Frame>

            <Label Text="Sua Resposta:" FontAttributes="Bold" TextColor="#2E7D32" Margin="0,10,0,0"/>
            <Frame Padding="5" BackgroundColor="White" CornerRadius="10">
                <Editor x:Name="editorResposta" 
                        Placeholder="Escreva sua resposta aqui..." 
                        HeightRequest="180" 
                        TextColor="Black"
                        BackgroundColor="White"/>
            </Frame>

            <Button Text="📎 Anexar Arquivo" Clicked="OnAnexarClicked" 
                    BackgroundColor="#81C784" TextColor="White" CornerRadius="10"/>

            <Label x:Name="lblArquivo" Text="Nenhum arquivo selecionado" 
                   FontSize="12" TextColor="#666" HorizontalOptions="Center"/>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,10,0,0">
                <Button Grid.Column="0" Text="RASCUNHO" Clicked="OnSalvarRascunhoClicked" 
                        BackgroundColor="#757575" TextColor="White" CornerRadius="10"/>
                <Button Grid.Column="1" Text="ENVIAR" Clicked="OnEnviarClicked" 
                        BackgroundColor="#2E7D32" TextColor="White" CornerRadius="10"/>
            </Grid>

            <Button Text="Cancelar" Clicked="OnVoltarClicked" 
                    BackgroundColor="Transparent" TextColor="#C62828" FontAttributes="Bold"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>