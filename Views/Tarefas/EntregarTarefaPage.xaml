<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudyFlow.Views.Tarefas.EntregarTarefaPage"
             BackgroundColor="#E8F5E9">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Detalhes da Tarefa (Vindo do Professor) -->
            <Frame BackgroundColor="White" CornerRadius="10" Padding="15">
                <VerticalStackLayout Spacing="5">
                    <Label x:Name="lblTitulo" FontSize="22" FontAttributes="Bold" TextColor="#2E7D32"/>
                    <Label x:Name="lblDescricao" FontSize="16" TextColor="#424242"/>
                    <Label x:Name="lblData" FontSize="12" TextColor="Red"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Campo de Resposta -->
            <Label Text="Sua Resposta" FontAttributes="Bold" TextColor="#E8F5E9" BackgroundColor="#2E7D32" Margin="0,10,0,0"/>
            <Frame Padding="2" BorderColor="#2E7D32" CornerRadius="8">
                <Editor x:Name="editorResposta" 
                        Placeholder="Digite sua resposta aqui..." 
                        HeightRequest="180" 
                        AutoSize="Disabled"
                        TextColor="#E8F5E9"
                        BackgroundColor="#2E7D32"/>
            </Frame>

            <!-- Anexo -->
            <Button Text=" Anexar Arquivo" 
                    Clicked="OnAnexarClicked" 
                    BackgroundColor="#81C784" 
                    TextColor="White"
                    CornerRadius="8"/>
            <Label x:Name="lblArquivo" Text="Nenhum arquivo anexado" FontSize="12" HorizontalOptions="Center"/>

            <!-- Botões de Ação -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,20,0,0">
                <Button Grid.Column="0" Text="SALVAR RASCUNHO" 
                        Clicked="OnSalvarRascunhoClicked" 
                        TextColor="#E8F5E9"
                        BackgroundColor="#2E7D32"/>

                <Button Grid.Column="1" Text="ENVIAR" 
                        Clicked="OnEnviarClicked" 
                        BackgroundColor="#2E7D32" TextColor="White"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>