<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudyFlow.Views.Tarefas.AvaliarTarefaPage"
             BackgroundColor="#E8F5E9">

    <Grid RowDefinitions="Auto, *" Padding="20">
        <VerticalStackLayout Grid.Row="0" Spacing="5" Margin="0,0,0,15">
            <Label x:Name="lblTarefaNome" FontSize="20" FontAttributes="Bold" TextColor="#2E7D32"/>
            <Label Text="Alunos que entregaram:" FontSize="14" TextColor="Gray"/>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" x:Name="listaEntregas">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="15" Margin="0,5" BackgroundColor="White" HasShadow="True">
                        <VerticalStackLayout Spacing="8">
                            <!-- Nota (Badge) -->
                            <Label Text="{Binding Nota, StringFormat='Nota: {0}'}" 
                                   TextColor="#2E7D32" FontAttributes="Bold" HorizontalOptions="End"/>

                            <Label Text="Resposta do Aluno:" FontSize="12" FontAttributes="Bold"/>
                            <Label Text="{Binding RespostaTexto}" FontSize="14" MaxLines="3"/>

                            <Button Text="VER RESPOSTA E DAR NOTA" 
                                    Clicked="OnAvaliarClicked" 
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#2E7D32" 
                                    TextColor="White"
                                    HeightRequest="40"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>