<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudyFlow.Views.Tarefas.MinhasTarefasPage"
             BackgroundColor="#E8F5E9">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20">
        <Label Grid.Row="0" Text="Minhas Criações" FontSize="26" FontAttributes="Bold" TextColor="#2E7D32" HorizontalOptions="Center" Margin="0,0,0,10"/>

        <Label x:Name="lblSemTarefas" Grid.Row="1" Text="Você ainda não criou tarefas." IsVisible="False" VerticalOptions="Center" HorizontalOptions="Center" TextColor="Gray"/>

        <CollectionView x:Name="listaTarefas" Grid.Row="1">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="12" Margin="0,5" BackgroundColor="White" CornerRadius="12" HasShadow="True">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding Titulo}" FontAttributes="Bold" FontSize="18" TextColor="#1B5E20"/>
                            <Label Text="{Binding Turma, StringFormat='Turma: {0}'}" FontSize="13" TextColor="#2E7D32" FontAttributes="Bold"/>
                            <Label Text="{Binding Descricao}" FontSize="14" TextColor="#424242"/>

                            <HorizontalStackLayout Spacing="10" Margin="0,10,0,0">
                                <Button Text="Editar" Clicked="OnEditarClicked" CommandParameter="{Binding .}" BackgroundColor="#E8F5E9" TextColor="#2E7D32" HeightRequest="40"/>
                                <Button Text="Excluir" Clicked="OnExcluirClicked" CommandParameter="{Binding .}" BackgroundColor="#FFEBEE" TextColor="#C62828" HeightRequest="40"/>
                                <Button Text="Corrigir" BackgroundColor="#FFF9C4" TextColor="#FBC02D" FontAttributes="Bold" Clicked="OnVerEntregasClicked" CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="2" Text="Voltar" Clicked="Button_Clicked" BackgroundColor="#2E7D32" TextColor="White" Margin="0,10,0,0"/>
    </Grid>
</ContentPage>