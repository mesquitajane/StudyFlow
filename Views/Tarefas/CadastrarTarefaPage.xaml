<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudyFlow.Views.Tarefas.CadastrarTarefaPage"
             BackgroundColor="#E8F5E9">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Cadastrar Tarefa"
               FontSize="24"
               FontAttributes="Bold"
               TextColor="#2E7D32"
               HorizontalOptions="Center"/>

        <Entry x:Name="entryTitulo"
               Placeholder="Título da tarefa" 
               TextColor="#E8F5E9"
               BackgroundColor="#2E7D32"/>

        <Entry x:Name="entryDescricao"
               Placeholder="Descrição"
               TextColor="#E8F5E9"
               BackgroundColor="#2E7D32"/>

        <DatePicker x:Name="dateEntrega" TextColor="#2E7D32"/>
        <Label Text="Enviar para a Turma" TextColor="#2E7D32" FontAttributes="Bold" />
        <Picker x:Name="pickerTurmaTarefa" Title="Escolha a turma" TextColor="#2E7D32" BackgroundColor="#E8F5E9">
            <Picker.Items>
                <x:String>1º Ano A</x:String>
                <x:String>2º Ano A</x:String>
                <x:String>3º Ano A</x:String>
            </Picker.Items>
        </Picker>
        
        <Button Text="Salvar"
                BackgroundColor="#2E7D32"
                TextColor="White"
                Clicked="OnSalvarClicked"/>

        <Button Text="Voltar"
                BackgroundColor="#2E7D32"
                TextColor="White"
                Clicked="OnVoltarClicked"/>

    </VerticalStackLayout>

</ContentPage>
