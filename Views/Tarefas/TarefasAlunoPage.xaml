<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudyFlow.Views.Tarefas.TarefasAlunoPage"
             BackgroundColor="#E8F5E9">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20">
        <VerticalStackLayout Grid.Row="0" Spacing="5" Margin="0,0,0,10">
            <Label Text="Minhas Tarefas" FontSize="26" FontAttributes="Bold" 
                   TextColor="#2E7D32" HorizontalOptions="Center"/>
            <Label x:Name="lblTurma" FontSize="14" TextColor="#555" HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" x:Name="listaTarefas">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="15" Margin="0,5" BackgroundColor="White" CornerRadius="10" HasShadow="True" BorderColor="#C8E6C9">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTarefaTapped" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding Tarefa.Titulo}" FontSize="18" FontAttributes="Bold" TextColor="#1B5E20"/>
                            <Label Text="{Binding Tarefa.Descricao}" FontSize="14" TextColor="#424242" MaxLines="2"/>
                            <HorizontalStackLayout Spacing="15" Margin="0,5,0,0">
                                <Label Text="{Binding StatusExibicao}" FontSize="12" FontAttributes="Bold" TextColor="#2E7D32"/>
                                <Label Text="{Binding NotaExibicao}" FontSize="12" FontAttributes="Bold" TextColor="#E65100"/>
                                <Label Text="Responder" FontSize="12" FontAttributes="Bold" TextColor="#424242"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="2" Text="Voltar ao Menu" Clicked="OnVoltarClicked" 
                BackgroundColor="#2E7D32" TextColor="White" CornerRadius="10" Margin="0,10,0,0"/>
    </Grid>
</ContentPage>