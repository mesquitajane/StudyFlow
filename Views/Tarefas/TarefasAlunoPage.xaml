<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudyFlow.Views.Tarefas.TarefasAlunoPage"
             BackgroundColor="#E8F5E9">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20">
        <VerticalStackLayout Grid.Row="0" Spacing="5" Margin="0,0,0,10">
            <Label Text="Tarefas da Turma" FontSize="26" FontAttributes="Bold" TextColor="#2E7D32" HorizontalOptions="Center"/>
            <Label x:Name="lblTurma" FontSize="14" TextColor="#666" HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <CollectionView x:Name="listaTarefas">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="15" Margin="5" BackgroundColor="White" CornerRadius="10" HasShadow="True">

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTarefaTapped" />
                        </Frame.GestureRecognizers>
                        
                        <VerticalStackLayout Spacing="5">

                            <Label Text="{Binding Titulo}" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="#1B5E20"/>

                          
                            <Label Text="{Binding Descricao}" 
                           FontSize="14" 
                           TextColor="#424242"/>

                            <HorizontalStackLayout Spacing="15" Margin="0,5,0,0">
                              
                                <Label Text="{Binding StatusExibicao}" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               TextColor="#2E7D32"/>

                               
                                <Label Text="{Binding NotaExibicao}" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               TextColor="#E65100"/>

                              <Label Text="Toque para responder" FontSize="10" TextColor="#2E7D32" HorizontalOptions="End" />
                            </HorizontalStackLayout>

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="2" Text="Sair" Clicked="OnVoltarClicked" BackgroundColor="#2E7D32" TextColor="White" Margin="0,10,0,0"/>
    </Grid>
</ContentPage>