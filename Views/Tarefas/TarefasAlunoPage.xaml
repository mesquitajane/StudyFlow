<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudyFlow.Views.Tarefas.TarefasAlunoPage"
             BackgroundColor="#E8F5E9"
             Title="Minhas Atividades">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20">
        <VerticalStackLayout Grid.Row="0" Spacing="5" Margin="0,0,0,10">
            <Label Text="Tarefas da Turma" FontSize="26" FontAttributes="Bold" TextColor="#2E7D32" HorizontalOptions="Center"/>
            <Label x:Name="lblTurma" FontSize="14" TextColor="#666" HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <CollectionView x:Name="listaTarefas" Grid.Row="1">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="15" Margin="0,5" CornerRadius="10" HasShadow="True">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding Titulo}" FontSize="18" FontAttributes="Bold" TextColor="#1B5E20"/>
                            <Label Text="{Binding Descricao}" FontSize="14" TextColor="#555"/>
                            <Label Text="{Binding DataEntrega, StringFormat='Entrega: {0:dd/MM/yyyy}'}" FontSize="12" TextColor="Red" FontAttributes="Bold"/>
                            <Label Text="{Binding Status}" FontSize="13" TextColor="#2E7D32" HorizontalOptions="End"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="2" Text="Sair" Clicked="OnVoltarClicked" BackgroundColor="#2E7D32" TextColor="White" Margin="0,10,0,0"/>
    </Grid>
</ContentPage>